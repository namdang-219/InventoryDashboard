# Copy to .env (same directory as docker-compose.yml) and edit values.
# Loaded automatically by docker compose.

# SQL Server — must satisfy the Microsoft complexity policy:
#   8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# Developer (free), Express, Standard, Enterprise, or leave blank for default.
MSSQL_PID=Developer

# API
# Generate a real one with: openssl rand -base64 48
JWT_KEY=dev-only-replace-me-with-a-32-byte-secret!!!
JWT_ISSUER=iid.local
JWT_AUDIENCE=iid.client
JWT_EXPIRY_MINUTES=60

# Comma-separated origins allowed by CORS (single origin supported by current config;
# extend appsettings.json if you need multi-origin).
CORS_ALLOWED_ORIGIN=http://localhost:4200

# OpenObserve (Observability Platform: Logs, Traces, Metrics)
OPENOBSERVE_EMAIL=admin@iid.local
OPENOBSERVE_PASSWORD=P@ssw0rd!OpenObserve
OPENOBSERVE_AUTH_TOKEN=YWRtaW5AaWlkLmxvY2FsOlBAc3N3MHJkIU9wZW5PYnNlcnZl
OPENOBSERVE_STREAM_NAME=iid-api

# OpenObserve & OpenTelemetry Metadata Tags (used for filtering & grouping)
OTEL_SERVICE_NAME=IID.Api
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=Production
