{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:8080",
  "ConnectionStrings": {
    "IID": "Server=localhost;Database=IID;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "iid.local",
    "Audience": "iid.client",
    "Key": "dev-only-replace-me-with-a-32-byte-secret!!!",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Swagger": {
    "Title": "Intelligent Inventory Dashboard API",
    "Version": "v1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  },
  "Seed": {
    "RunMigrations": true,
    "RunSeeders": true
  }
}